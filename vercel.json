{
  "version": 2,
  "headers": [
    {
      "source": "/(.*).html",
      "headers": [
        { "key": "Cache-Control", "value": "no-cache, no-store, must-revalidate" }
      ]
    }
  ],
  "routes": [
    {
      "src": "/manifest.json",
      "dest": "/manifest.json"
    },
    {
      "src": "/sw.js",
      "dest": "/sw.js"
    },
    {
      "src": "/icon-192.png",
      "dest": "/icon-192.png"
    },
    {
      "src": "/icon-512.png",
      "dest": "/icon-512.png"
    },
    {
      "src": "/tracium.png",
      "dest": "/tracium.png"
    },
    {
      "src": "/",
      "dest": "/index.html"
    },
    {
      "src": "/app",
      "dest": "/app.html"
    },
    {
      "src": "/auth",
      "dest": "/auth.html"
    },
    {
      "src": "/dashboard",
      "dest": "/dashboard.html"
    },
    {
      "src": "/register",
      "dest": "/register.html"
    },
    {
      "src": "/payment",
      "dest": "/payment.html"
    },
    {
      "src": "/installer",
      "dest": "/installer.html"
    },
    {
      "src": "/installer-auth",
      "dest": "/installer-auth.html"
    },
    {
      "src": "/shop",
      "dest": "/shop.html"
    },
    {
      "src": "/notifications",
      "dest": "/notifications.html"
    },
    {
      "src": "/blocage",
      "dest": "/blocage.html"
    },
    {
      "src": "/police",
      "dest": "/police.html"
    },
    {
      "src": "/assureurs",
      "dest": "/assureurs.html"
    },
    {
      "src": "/chat",
      "dest": "/chat.html"
    },
    {
      "src": "/pitch",
      "dest": "/pitchdeck.html"
    },
    {
      "src": "/puce-fantome",
      "dest": "/puce-fantome.html"
    },
    {
      "src": "/leads",
      "dest": "/leads.html"
    },
    {
      "src": "/growth",
      "dest": "/growth.html"
    },
    {
      "src": "/(.*)",
      "dest": "/index.html"
    }
  ]
}
